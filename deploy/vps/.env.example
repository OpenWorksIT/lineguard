# Copy to .env (chmod 600 .env) and set a username and a password of 12 characters or more.
# Users log in with these.
LINEGUARD_USER=choose-a-username
LINEGUARD_PASSWORD=change-me-to-something-long

# The address phones and browsers use to reach this server. Must be https.
LINEGUARD_PUBLIC_URL=https://lineguard.example.com

# LineGuard sits behind Caddy: take each client's address from Caddy's X-Forwarded-For, so failed-login
# limits apply per client. Only set this when the container is reachable through the proxy alone.
LINEGUARD_BEHIND_PROXY=1

# Camera-to-conductor distance the test flights are flown at, metres.
LINEGUARD_STANDOFF_M=20

# Largest single upload, MB (a zipped flight folder).
LINEGUARD_MAX_UPLOAD_MB=4096

# For real DJI photos, once the Thermal SDK is mounted (see docker-compose.yml):
# LINEGUARD_DJI_IRP=/opt/dji_thermal_sdk/utility/bin/linux/release_x64/dji_irp
